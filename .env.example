# Environment Variables Example

# This file contains example environment variables.
# Copy this file to .env.local and fill in your values.

# ============================================
# Supabase (REQUIRED)
# ============================================
# Create a project at https://supabase.com → Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Application Settings
# ============================================

# Application Name
VITE_APP_NAME=Aethon

# Application Version
VITE_APP_VERSION=1.0.0

# ============================================
# Blockchain Settings
# ============================================

# Default RPC Provider (optional)
# Used for reading blockchain data if needed
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Infura Project ID (optional)
# Get from https://infura.io
VITE_INFURA_PROJECT_ID=

# Etherscan API Key (optional)
# Used for contract verification
# Get from https://etherscan.io/apis
VITE_ETHERSCAN_API_KEY=

# ============================================
# Network Configuration
# ============================================

# Default Network
# Options: sepolia, mainnet
VITE_DEFAULT_NETWORK=sepolia

# ============================================
# Feature Flags
# ============================================

# Enable development features
VITE_DEBUG_MODE=false

# Enable experimental features
VITE_EXPERIMENTAL_FEATURES=false

# ============================================
# Build Settings
# ============================================

# Build mode
NODE_ENV=development

# Source maps for debugging
VITE_SOURCE_MAP=true

# ============================================
# Hardhat / local deploy scripts (optional)
# ============================================
# Used by hardhat.config.ts — never commit real private keys.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=
MAINNET_RPC_URL=
MAINNET_PRIVATE_KEY=
INFURA_PROJECT_ID=
ETHERSCAN_API_KEY=
REPORT_GAS=

# ============================================
# The Graph (platform indexer — operator sets these for the default path)
# ============================================
# Deploy CryptPIndexRegistry once, publish subgraph/, then set:

VITE_GRAPH_REGISTRY_ADDRESS=
VITE_GRAPH_ENDPOINT=

# End users can skip Studio for the platform path, OR paste their own
# Studio query URL under Settings → The Graph / Indexed → My Graph Studio.

# ============================================
# Chainlink CRE Confidential Audit Gate
# ============================================
# Public (Vite). Local dev can omit VITE_CRE_TRIGGER_URL (falls back to localhost:3001).
# Production / Railway MUST set a real proxy URL — never ship relying on localhost.

# VITE_CRE_TRIGGER_URL=http://localhost:3001/cre/audit
VITE_CRE_TRIGGER_URL=
VITE_CRE_WORKFLOW_ID=
VITE_CRE_CONSUMER_ADDRESS=
# Optional: must match server CRE_AUDIT_TOKEN when that is set
# VITE_CRE_AUDIT_TOKEN=

# ============================================
# Chainlink Price Feeds (A) — ETH/USD on Sepolia
# ============================================
# Official Sepolia ETH/USD feed (reference): 0x694AA1769357215DE4FAC081bf1f309aDC325306
# Deploy: npm run deploy:eth-usd-consumer
VITE_ETH_USD_CONSUMER_ADDRESS=

# ============================================
# Uniswap v4 Continuity (CounterHook)
# ============================================
# Sepolia PoolManager: 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
# Deploy: npm run deploy:counter-hook
VITE_UNISWAP_COUNTER_HOOK=

# Server-only (compilerBackend / Railway) — never put these in VITE_*
# CRE_TRIGGER_PRIVATE_KEY=
# CRE_WORKFLOW_ID=
# CRE_GATEWAY_URL=https://01.gateway.zone-a.cre.chain.link
# CRE_FORCE_LIVE=0
# CRE_VERDICT_REPORTER=
# CRE_CORS_ORIGINS=https://your-app.example,http://localhost:5173
# CRE_AUDIT_TOKEN=

# ============================================
# Playwright smoke tests (local + CI)
# ============================================
# Dedicated test account — do not use a personal password in CI logs.
# Rotate this account if credentials were ever committed to git history.

SMOKE_EMAIL=your-smoke-test@example.com
SMOKE_PASSWORD=your-smoke-test-password

# Optional: override dev server URL (default http://localhost:5173)
# SMOKE_BASE_URL=http://localhost:5173

# ============================================
# Notes
# ============================================

# - Do NOT commit .env.local to version control
# - Keep sensitive keys private
# - Use different keys for development, staging, and production
# - Rotate keys regularly
# - Never share API keys in public repositories
